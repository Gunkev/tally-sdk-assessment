# BasicFormFlow

main: kit: flow: BasicFormFlow:
{
  entity: "form",
  kind: "basic",
  name: "BasicFormFlow",
  step: [
    {
      i: {
        ref: "form_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "form_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "form_ref01",
        srcdatavar: "form_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-form_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "form_ref01",
        srcdatavar: "form_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "form01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-form_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "form_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "form01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "form_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFormFlow"
}