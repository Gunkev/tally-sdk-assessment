# BasicOrganizationFlow

main: kit: flow: BasicOrganizationFlow:
{
  entity: "organization",
  kind: "basic",
  name: "BasicOrganizationFlow",
  step: [
    {
      i: {
        ref: "organization_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "organization_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "organization_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "organization_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOrganizationFlow"
}